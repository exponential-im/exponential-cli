{
  "name": "exponential-cli",
  "version": "1.29.0",
  "description": "The Exponential command line: actions, projects, OKRs, tickets, decisions, meetings and time, with JSON output for scripts and AI agents",
  "type": "module",
  "bin": {
    "exponential": "bin/exponential.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "productivity",
    "actions",
    "tasks",
    "exponential",
    "project-management",
    "okr",
    "ai-agents",
    "json",
    "terminal"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exponential-im/exponential-cli.git"
  },
  "homepage": "https://www.exponential.im/features/integrations/cli",
  "bugs": {
    "url": "https://github.com/exponential-im/exponential-cli/issues"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "exponential-sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
